OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 本機開發使用 localhost；Streamlit Cloud 則在 Secrets 設為 Render HTTPS URL。
BACKEND_API_URL=http://localhost:8000
DATABASE_URL=postgresql://username:password@host/database
DIRECT_DATABASE_URL=postgresql://username:password@host/database
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 本機預設不啟用；正式環境需設定 Redis URL 並開啟分散式限流。
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
API_RATE_LIMIT_REQUESTS=60
